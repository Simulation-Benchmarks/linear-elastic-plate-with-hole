name: RoHub Upload CI
on:
  workflow_dispatch:
    inputs:
      branch:
        description: Branch whose latest successful tool CI artifacts should be published
        required: true
        default: main
      use_production_rohub:
        description: Upload to production RoHub
        required: true
        type: boolean
        default: true

permissions:
  actions: read
  contents: read

env:
  BENCHMARK_NAME: linear-elastic-plate-with-hole
  BENCHMARK_VERSION: 1.0.0
  BRANCH_NAME: ${{ inputs.branch }}
  CODE_REPOSITORY_URL: https://github.com/${{ github.repository }}/tree/${{ inputs.branch }}
  USE_PRODUCTION_ROHUB: ${{ inputs.use_production_rohub }}

jobs:
  upload-rocrates:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo content
        uses: actions/checkout@v6
        with:
          ref: ${{ inputs.branch }}

      - name: Find latest successful tool CI runs
        id: tool-runs
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail

          find_run() {
            local workflow="$1"
            local prefix="$2"
            local run

            run="$(gh run list \
              --workflow "${workflow}" \
              --branch "${BRANCH_NAME}" \
              --status success \
              --limit 1 \
              --json databaseId,headSha \
              --jq '.[0]')"

            if [ "${run}" = "null" ] || [ -z "${run}" ]; then
              echo "No successful ${workflow} run found for branch ${BRANCH_NAME}." >&2
              exit 1
            fi

            echo "${prefix}_run_id=$(jq -r '.databaseId' <<< "${run}")" >> "${GITHUB_OUTPUT}"
            echo "${prefix}_sha=$(jq -r '.headSha' <<< "${run}")" >> "${GITHUB_OUTPUT}"
          }

          find_run "run-benchmark-fenics.yml" "fenics"
          find_run "run-benchmark-kratos.yml" "kratos"
          find_run "run-benchmark-exfem.yml" "extendablefem"

      - name: Require all tool CI runs to use the same commit
        shell: bash
        env:
          FENICS_SHA: ${{ steps.tool-runs.outputs.fenics_sha }}
          KRATOS_SHA: ${{ steps.tool-runs.outputs.kratos_sha }}
          EXTENDABLEFEM_SHA: ${{ steps.tool-runs.outputs.extendablefem_sha }}
        run: |
          set -euo pipefail

          if [ "${FENICS_SHA}" != "${KRATOS_SHA}" ] || [ "${FENICS_SHA}" != "${EXTENDABLEFEM_SHA}" ]; then
            echo "Latest successful tool runs do not point to the same commit." >&2
            echo "Fenics: ${FENICS_SHA}" >&2
            echo "Kratos: ${KRATOS_SHA}" >&2
            echo "ExtendableFEM: ${EXTENDABLEFEM_SHA}" >&2
            exit 1
          fi

          echo "BRANCH_COMMIT_SHA=${FENICS_SHA}" >> "${GITHUB_ENV}"

      - name: Download aggregate RO-Crate artifacts
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          FENICS_RUN_ID: ${{ steps.tool-runs.outputs.fenics_run_id }}
          KRATOS_RUN_ID: ${{ steps.tool-runs.outputs.kratos_run_id }}
          EXTENDABLEFEM_RUN_ID: ${{ steps.tool-runs.outputs.extendablefem_run_id }}
        run: |
          set -euo pipefail

          gh run download "${FENICS_RUN_ID}" \
            --name "fenics-aggregate-rocrate" \
            --dir "artifacts/fenics"

          gh run download "${KRATOS_RUN_ID}" \
            --name "kratos-aggregate-rocrate" \
            --dir "artifacts/kratos"

          gh run download "${EXTENDABLEFEM_RUN_ID}" \
            --name "extendablefem-aggregate-rocrate" \
            --dir "artifacts/extendablefem"

      - name: Setup Mambaforge with provenance env
        uses: conda-incubator/setup-miniconda@v4
        with:
          miniforge-version: latest
          activate-environment: provenance
          use-mamba: true
          environment-file: provenance/environment_provenance.yml
          conda-remove-defaults: "true"

      - name: Select RoHub credentials
        shell: bash
        run: |
          if [ "${USE_PRODUCTION_ROHUB}" = "true" ]; then
            echo "ROHUB_USERNAME=${{ secrets.ROHUB_PROD_USERNAME }}" >> "${GITHUB_ENV}"
            echo "ROHUB_PASSWORD=${{ secrets.ROHUB_PROD_PASSWORD }}" >> "${GITHUB_ENV}"
          else
            echo "ROHUB_USERNAME=${{ secrets.ROHUB_DEV_USERNAME }}" >> "${GITHUB_ENV}"
            echo "ROHUB_PASSWORD=${{ secrets.ROHUB_DEV_PASSWORD }}" >> "${GITHUB_ENV}"
          fi

      - name: Upload Fenics RO-Crate Zip file onto RoHub
        shell: bash -l {0}
        continue-on-error: true
        env:
          TOOL: fenics
          TOOL_DISPLAY_NAME: Fenics
          USED_SOFTWARE_URL: https://zbmath.org/software/4314
        run: |
          ROCRATE_TITLE="NFDI4Ing Provenance (${TOOL_DISPLAY_NAME}) ${BENCHMARK_VERSION}"

          if [ "${BRANCH_NAME}" != "main" ]; then
            ROCRATE_TITLE="${ROCRATE_TITLE}_${BRANCH_COMMIT_SHA:0:7}"
          fi

          python provenance/upload_provenance.py \
            --provenance_folderpath "${GITHUB_WORKSPACE}/artifacts/${TOOL}/${TOOL}_rocrate.zip" \
            --benchmark-name "${BENCHMARK_NAME}" \
            --username "${ROHUB_USERNAME}" \
            --password "${ROHUB_PASSWORD}" \
            --rocrate-title "${ROCRATE_TITLE}" \
            --code-repository-url "${CODE_REPOSITORY_URL}" \
            --used-software-url "${USED_SOFTWARE_URL}" \
            --use-production-rohub "${USE_PRODUCTION_ROHUB}"

      - name: Upload Kratos RO-Crate Zip file onto RoHub
        shell: bash -l {0}
        continue-on-error: true
        env:
          TOOL: kratos
          TOOL_DISPLAY_NAME: Kratos
          USED_SOFTWARE_URL: https://zbmath.org/software/7804
        run: |
          ROCRATE_TITLE="NFDI4Ing Provenance (${TOOL_DISPLAY_NAME}) ${BENCHMARK_VERSION}"

          if [ "${BRANCH_NAME}" != "main" ]; then
            ROCRATE_TITLE="${ROCRATE_TITLE}_${BRANCH_COMMIT_SHA:0:7}"
          fi

          python provenance/upload_provenance.py \
            --provenance_folderpath "${GITHUB_WORKSPACE}/artifacts/${TOOL}/${TOOL}_rocrate.zip" \
            --benchmark-name "${BENCHMARK_NAME}" \
            --username "${ROHUB_USERNAME}" \
            --password "${ROHUB_PASSWORD}" \
            --rocrate-title "${ROCRATE_TITLE}" \
            --code-repository-url "${CODE_REPOSITORY_URL}" \
            --used-software-url "${USED_SOFTWARE_URL}" \
            --use-production-rohub "${USE_PRODUCTION_ROHUB}"

      - name: Upload ExtendableFEM RO-Crate Zip file onto RoHub
        shell: bash -l {0}
        continue-on-error: true
        env:
          TOOL: extendablefem
          TOOL_DISPLAY_NAME: ExtendableFEM
          USED_SOFTWARE_URL: https://zbmath.org/software/53664
        run: |
          ROCRATE_TITLE="NFDI4Ing Provenance (${TOOL_DISPLAY_NAME}) ${BENCHMARK_VERSION}"

          if [ "${BRANCH_NAME}" != "main" ]; then
            ROCRATE_TITLE="${ROCRATE_TITLE}_${BRANCH_COMMIT_SHA:0:7}"
          fi

          python provenance/upload_provenance.py \
            --provenance_folderpath "${GITHUB_WORKSPACE}/artifacts/${TOOL}/${TOOL}_rocrate.zip" \
            --benchmark-name "${BENCHMARK_NAME}" \
            --username "${ROHUB_USERNAME}" \
            --password "${ROHUB_PASSWORD}" \
            --rocrate-title "${ROCRATE_TITLE}" \
            --code-repository-url "${CODE_REPOSITORY_URL}" \
            --used-software-url "${USED_SOFTWARE_URL}" \
            --use-production-rohub "${USE_PRODUCTION_ROHUB}"

  wait-for-rohub-processing:
    runs-on: ubuntu-latest
    needs: upload-rocrates
    steps:
      - name: Wait for RoHub processing
        run: sleep 600

  process-artifacts:
    runs-on: ubuntu-latest
    needs: wait-for-rohub-processing
    env:
      USE_PRODUCTION_ROHUB: ${{ inputs.use_production_rohub }}

    steps:
      - name: Checkout repo content
        uses: actions/checkout@v6
        with:
          ref: ${{ inputs.branch }}

      - name: Setup Mambaforge with provenance env
        uses: conda-incubator/setup-miniconda@v4
        with:
          miniforge-version: latest
          activate-environment: provenance
          use-mamba: true
          environment-file: provenance/environment_provenance.yml
          conda-remove-defaults: "true"

      - name: Run Fenics plotting script
        shell: bash -l {0}
        continue-on-error: true
        run: |
          python provenance/plot_plate_with_hole_metrics.py \
            --tool "fenics" \
            --output-file "fenics-element-size-vs-stress-plot.pdf" \
            --use-production-rohub "${USE_PRODUCTION_ROHUB}"

      - name: Upload Fenics plot artifact
        uses: actions/upload-artifact@v6
        with:
          name: fenics-plot
          path: fenics-element-size-vs-stress-plot.pdf
          if-no-files-found: ignore

      - name: Run Kratos plotting script
        shell: bash -l {0}
        continue-on-error: true
        run: |
          python provenance/plot_plate_with_hole_metrics.py \
            --tool "kratos" \
            --output-file "kratos-element-size-vs-stress-plot.pdf" \
            --use-production-rohub "${USE_PRODUCTION_ROHUB}"

      - name: Upload Kratos plot artifact
        uses: actions/upload-artifact@v6
        with:
          name: kratos-plot
          path: kratos-element-size-vs-stress-plot.pdf
          if-no-files-found: ignore

      - name: Run ExtendableFEM plotting script
        shell: bash -l {0}
        continue-on-error: true
        run: |
          python provenance/plot_plate_with_hole_metrics.py \
            --tool "extendablefem" \
            --output-file "extendablefem-element-size-vs-stress-plot.pdf" \
            --use-production-rohub "${USE_PRODUCTION_ROHUB}"

      - name: Upload ExtendableFEM plot artifact
        uses: actions/upload-artifact@v6
        with:
          name: extendablefem-plot
          path: extendablefem-element-size-vs-stress-plot.pdf
          if-no-files-found: ignore
