rule all:
    input:
        "solution_field_data.zip",
        "solution_metrics.json"

include: "Setup.smk"

rule create_mesh:    
    input:
        script = "create_mesh.py",
        parameters = workflow.configfiles[0],
    output:
        mesh = "mesh.msh",
    conda: "environment_mesh.yml"
    shell:
        """
        python3 {input.script} --input_parameter_file {input.parameters} --output_mesh_file {output.mesh}
        """

rule run_extendablefem_simulation:
    input: 
        parameters = workflow.configfiles[0],
        mesh = "mesh.msh",
        manifest = str(SHARED_PROJECT_DIR / "Manifest.toml"),
    output:
        zip = "solution_field_data.zip",
        metrics = "solution_metrics.json",
    singularity: JULIA_IMAGE
    params: project_dir=str(SHARED_PROJECT_DIR)
    shell:
        """
        julia --project={params.project_dir:q} run_extendablefem_simulation.jl --configfile {input.parameters} --meshfile {input.mesh} --outputzip {output.zip} --outputmetrics {output.metrics}
        """
