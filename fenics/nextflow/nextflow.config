conda {
    enabled = true
}

plugins {
  id 'nf-prov'
}

prov {
  enabled = true
  formats {
    wrroc {
       agent {
          name = 'Firstname Lastname'
          orcid = 'https://orcid.org/0000-0000-0000-0000'
       }
       file = "ro-crate-metadata.json"
       license = 'https://spdx.org/licenses/MIT'
       overwrite = true
    }
  }
}