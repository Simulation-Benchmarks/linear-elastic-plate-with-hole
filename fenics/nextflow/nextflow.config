conda {
    enabled = true
}

env {
    UCX_TRANSPORTS = 'tcp'
    OMPI_MCA_btl = '^openib'
}

plugins {
  id 'nf-prov@1.7.0'
}

prov {
  enabled = true
  formats {
    wrroc {
       file = "ro-crate-metadata.json"
       license = 'https://spdx.org/licenses/MIT'
       overwrite = true
    }
  }
}